{
  "$schema": "https://neleto.io/schemas/main/plugin_manifest_schema.json",
  "name": "form-plugin",
  "version": "3.7.0",
  "hero_image": "assets/hero.png",
  "bin": "./target/x86_64-unknown-linux-gnu/release/form-plugin",
  "include_files": [
    "ui/dist/**/*",
    "target/x86_64-unknown-linux-gnu/release/form-plugin",
    "templates/**/*.html",
    "components/**/*"
  ],
  "components": "./components",
  "ui": "/ui",
  "pages": [
    {
      "name": "form-submit",
      "route": "/form-plugin/submit",
      "enable_tailwind": false,
      "allow_select_layout": false
    }
  ],
  "api": [
    {
      "route": "/api/forms",
      "allowed_permissions": ["settings.update"]
    },
    {
      "route": "/api/forms/preview",
      "allowed_permissions": ["settings.update"]
    },
    {
      "route": "/api/form-select/list"
    },
    {
      "route": "/api/form-select/by-id"
    },
    {
      "route": "/api/emails",
      "allowed_permissions": ["settings.update"]
    },
    {
      "route": "/api/settings",
      "allowed_permissions": ["settings.update"]
    },
    {
      "route": "/api/submissions",
      "allowed_permissions": ["settings.update"]
    },
    {
      "route": "/api/submissions/count",
      "allowed_permissions": ["settings.update"]
    },
    {
      "route": "/api/submissions/send-email",
      "allowed_permissions": ["settings.update"]
    },
    {
      "route": "/api/submissions/stats",
      "allowed_permissions": ["settings.update"]
    },
    {
      "route": "/api/submissions/export",
      "allowed_permissions": ["settings.update"]
    },
    {
      "route": "/api/submissions/recent",
      "allowed_permissions": ["settings.update"]
    },
    {
      "route": "/api/submissions/download-files",
      "allowed_permissions": ["settings.update"]
    }
  ],
  "helpers": [
    {
      "name": "render_form",
      "route": "/helper/render_form",
      "type": "inline",
      "return_value": "String",
      "arguments": ["Number", "String"]
    }
  ],
  "dashboard_cards": [
    {
      "name": "recent-submissions",
      "route": "/dashboard/recent-submissions",
      "label": {
        "de": "Neueste Einreichungen",
        "en": "Recent Submissions"
      },
      "description": {
        "de": "Zeigt die neuesten 10 Einreichungen",
        "en": "Shows the latest 10 submissions"
      }
    },
    {
      "name": "submission-stats",
      "route": "/dashboard/submission-stats",
      "label": {
        "de": "Einreichungsstatistik",
        "en": "Submission Stats"
      },
      "description": {
        "de": "Zeigt die Statistik der Einreichungen",
        "en": "Shows the submission stats"
      }
    }
  ]
}
