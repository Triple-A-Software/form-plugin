{
	"$schema": "./plugin_manifest_schema.json",
	"name": "form-plugin",
	"version": "3.0.0",
	"bin": "./target/debug/form-plugin",
	"include_files": [
		"ui/dist/**/*",
		"target/debug/form-plugin",
		"templates/**/*.html",
		"components/**/*"
	],
	"components": "./components",
	"ui": "/ui",
	"pages": [
		{
			"name": "form-submit",
			"route": "/form-plugin/submit"
		}
	],
	"api": [
		{
			"route": "/api/forms",
			"allowed_roles": ["admin", "developer"]
		},
		{
			"route": "/api/forms/preview",
			"allowed_roles": ["admin", "developer"]
		},
		{
			"route": "/api/emails",
			"allowed_roles": ["admin", "developer"]
		},
		{
			"route": "/api/submissions",
			"allowed_roles": ["admin", "developer"]
		},
		{
			"route": "/api/form-select",
			"allowed_roles": ["admin", "developer", "editor", "author"]
		}
	],
	"helpers": [
		{
			"name": "render_form",
			"route": "/helper/render_form",
			"type": {
				"return_value": "String",
				"arguments": ["Number", "String"],
				"block": false
			}
		}
	]
}
