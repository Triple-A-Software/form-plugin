{
	"$schema": "./plugin_manifest_schema.json",
	"name": "form-plugin",
	"version": "3.0.0",
	"bin": "./main",
	"ui": "/ui",
	"api": [
		{
			"route": "/api/forms",
			"allowed_roles": ["admin", "developer"]
		},
		{
			"route": "/api/emails",
			"allowed_roles": ["admin", "developer"]
		}
	],
	"helpers": [
		{
			"name": "render_form",
			"route": "/helper/render_form",
			"type": {
				"return_value": "String",
				"arguments": ["Number"],
				"block": false
			}
		}
	]
}
